{
  "name": "Arena",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "src/shared"
      },
      "WeaponTools": {
        "$path": "assets/weapons/tools"
      },
      "SkinAssets": {
        "$className": "Folder",
        "Models": {
          "$path": "assets/skins/Models"
        },
        "Shots": {
          "$path": "assets/skins/Shots"
        }
      },
      "Tuning": {
        "$className": "Configuration",
        "$ignoreUnknownInstances": true,
        "$attributes": {
          "IntermissionSeconds": 5,
          "RoundSeconds": 90,
          "RoundsToWin": 5,
          "RespawnSeconds": 3,
          "Convergence_TeamSize": 1,
          "Convergence_MinTeamSize": 1,
          "Convergence_FillWaitSeconds": 30,
          "Convergence_HardCapSeconds": 720,
          "Convergence_OvertimeMaxSeconds": 60,
          "Convergence_ScoreToWin": 1200,
          "Convergence_PointsPerZonePerSecond": 1,
          "Convergence_KillPoints": 5,
          "Convergence_CaptureSeconds": 8,
          "Convergence_StackBonus": 0.5,
          "Convergence_MaxStack": 3,
          "Convergence_ZoneCloseWarningSeconds": 15,
          "Convergence_RespawnSeconds": 3.5,
          "Convergence_SpawnProtectSeconds": 2,
          "Convergence_BotsPerTeam": 0,
          "Debug_ForceMap": "",
          "Debug_CarrierTestSafety": true,
          "Debug_CountBotMatches": true
        }
      },
      "Uploads": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "WeaponsSystem": {
        "$path": "assets/WeaponsSystem.rbxm"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}